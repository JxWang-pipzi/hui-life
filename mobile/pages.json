  "tabBar": {
    "color": "#6b7280",
    "selectedColor": "#0f766e",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home-normal.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/services/index",
        "text": "服务",
        "iconPath": "static/tabbar/services-normal.png",
        "selectedIconPath": "static/tabbar/services-active.png"
      },
      {
        "pagePath": "pages/orders/index",
        "text": "订单",
        "iconPath": "static/tabbar/orders-normal.png",
        "selectedIconPath": "static/tabbar/orders-active.png"
      },
      {
        "pagePath": "pages/profile/index",
