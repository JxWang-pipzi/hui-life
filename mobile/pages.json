{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-icons$": "@/components/uni-icons/uni-icons.vue",
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
